# clangd config for command-line / editor clangd using the CMake compile_commands.json
# (root symlink → cmake-build-debug/). The build uses arm-none-eabi-gcc; a few of its flags
# aren't understood by clangd's clang driver, so strip them to avoid spurious diagnostics.
# CLion uses its own indexer and ignores this file.
CompileFlags:
  Remove:
    - -mthumb-interwork
    - -mfloat-abi=*
    - -mfpu=*
    - -mcpu=*
Diagnostics:
  # util.h-style aggregator headers legitimately pull in includes used only by inline fns;
  # clangd's IWYU "unused include" lint is noisy here.
  UnusedIncludes: None
